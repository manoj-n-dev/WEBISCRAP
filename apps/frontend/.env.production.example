# ==============================================================================
# WEBISCRAP — Production Frontend Environment Configuration Template
# Populate these values in your Vercel Project Settings (Environment Variables)
# ==============================================================================

# Backend API URL (deployed on Render, e.g. https://webiscrap-api.onrender.com)
NEXT_PUBLIC_API_URL=https://webiscrap-api.onrender.com

# Frontend Application Canonical URL
NEXT_PUBLIC_APP_URL=https://webiscrap.vercel.app

# Firebase Authentication (Optional — for Phone OTP in production)
NEXT_PUBLIC_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=webiscrap.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=webiscrap

# Google OAuth Client ID (Optional — for Google Login in production)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com
