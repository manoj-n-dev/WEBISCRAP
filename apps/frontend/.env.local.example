# ── Backend ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
# Same-origin proxy for /api/auth/* (recommended; keeps the refresh cookie first-party). Set "false" to disable.
NEXT_PUBLIC_AUTH_PROXY=true

# ── Google sign-in (Google Identity Services; only the PUBLIC OAuth client id is exposed) ──
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client (Web) → Authorized JavaScript origins:
#   https://webiscrap.vercel.app   and   http://localhost:3000
# The backend GOOGLE_CLIENT_ID must be the SAME value.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ── Optional Firebase fallback (only used when NEXT_PUBLIC_GOOGLE_CLIENT_ID is empty). No keys are hard-coded any more. ──
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Misc ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://webiscrap.vercel.app
# Shown in Terms/Privacy. If empty, the GitHub issues link is shown instead.
NEXT_PUBLIC_CONTACT_EMAIL=
