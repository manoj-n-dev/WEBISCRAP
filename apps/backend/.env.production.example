# ==============================================================================
# WEBISCRAP — Production Backend Environment Configuration Template
# Populate these values in your Render Web Service Environment Settings
# ==============================================================================

# Core Environment
ENVIRONMENT=production
PORT=8000
FRONTEND_URL=https://webiscrap.vercel.app
BACKEND_CORS_ORIGINS=https://webiscrap.vercel.app,https://www.webiscrap.com
TRUST_PROXY_HEADERS=True

# Database (Neon PostgreSQL with SSL and asyncpg driver)
DATABASE_URL=postgresql+asyncpg://neondb_owner:YOUR_PASSWORD@ep-sample-123456.us-east-2.aws.neon.tech/neondb?ssl=require

# Cache & Message Queue (Upstash Redis or Render Redis with SSL)
REDIS_URL=rediss://default:YOUR_UPSTASH_TOKEN@sample-redis-12345.upstash.io:6379

# Authentication & Security
# Must be cryptographically random and at least 32 characters long
JWT_SECRET=generate-a-strong-random-64-character-hex-string-for-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
RESET_TOKEN_EXPIRE_MINUTES=15
RATE_LIMIT_PER_MINUTE=60

# AI Provider — Groq Key Pool (comma-separated for automatic failover/rotation)
GROQ_API_KEYS=gsk_key1_abcdef1234567890,gsk_key2_abcdef1234567890

# SMTP / Email Service (SendGrid, Mailgun, Amazon SES, or custom SMTP)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=YOUR_SENDGRID_API_KEY
SMTP_TLS=True
EMAILS_FROM_EMAIL=noreply@webiscrap.com
EMAILS_FROM_NAME=WEBISCRAP

# OAuth Providers (Optional — for Google Login)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Firebase Authentication (Optional — for Phone OTP)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-firebase-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
