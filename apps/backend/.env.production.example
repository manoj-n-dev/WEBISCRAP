# ==============================================================================
# WEBISCRAP — Production Backend Environment Configuration Template
# Populate these values in your Render Web Service Environment Settings
# ==============================================================================

# Core Environment
ENVIRONMENT=production
PORT=8000
FRONTEND_URL=https://webiscrap.vercel.app
BACKEND_CORS_ORIGINS=https://webiscrap.vercel.app,https://www.webiscrap.com
TRUST_PROXY_HEADERS=True

# Database (Neon PostgreSQL with SSL and asyncpg driver)
DATABASE_URL=postgresql+asyncpg://neondb_owner:YOUR_PASSWORD@ep-sample-123456.us-east-2.aws.neon.tech/neondb?ssl=require

# Cache & Message Queue (Upstash Redis or Render Redis with SSL)
REDIS_URL=rediss://default:YOUR_UPSTASH_TOKEN@sample-redis-12345.upstash.io:6379

# Authentication & Security
# Must be cryptographically random and at least 32 characters long
JWT_SECRET=generate-a-strong-random-64-character-hex-string-for-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
RESET_TOKEN_EXPIRE_MINUTES=15
RATE_LIMIT_PER_MINUTE=60

# AI Provider — Groq Key Pool (comma-separated for automatic failover/rotation)
GROQ_API_KEYS=gsk_key1_abcdef1234567890,gsk_key2_abcdef1234567890

# ── Email delivery ────────────────────────────────────────────────────────
# Render FREE web services BLOCK outbound SMTP ports 25/465/587, so smtp.gmail.com:587 can never work there.
# Use an HTTPS API instead (recommended): create a free Brevo account, verify a sender address, then set:
#   EMAIL_PROVIDER=brevo   BREVO_API_KEY=xkeysib-...   EMAILS_FROM_EMAIL=<the VERIFIED sender address>
# (or EMAIL_PROVIDER=resend + RESEND_API_KEY + a verified domain). Leave EMAIL_PROVIDER=auto to pick whichever key is set.
EMAIL_PROVIDER=auto
BREVO_API_KEY=
RESEND_API_KEY=

# ── LLM budget / behaviour ────────────────────────────────────────────────
# "free" keeps every Groq request under the free-tier 8,000 tokens-per-minute cap. Use "dev" after upgrading your Groq plan.
GROQ_TIER=free
ANALYZER_MODE=heuristic
# PLANNER_MODE=fast skips the planner LLM call (faster, fewer tokens; the user's message becomes the goal)
PLANNER_MODE=llm
CLEANER_MODE=deterministic
MAX_CONCURRENT_BROWSERS=1
ENABLE_SCRAPE_WORKER=false

# SMTP fallback only (custom SMTP on a paid host, or Brevo SMTP on port 2525)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=YOUR_SENDGRID_API_KEY
SMTP_TLS=True
EMAILS_FROM_EMAIL=noreply@webiscrap.com
EMAILS_FROM_NAME=WEBISCRAP

# OAuth Providers (Optional — for Google Login)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Firebase Authentication (Optional — for Phone OTP)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY_ID=your-firebase-private-key-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-firebase-project.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=your-firebase-client-id
FIREBASE_CLIENT_X509_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk%40your-firebase-project.iam.gserviceaccount.com
